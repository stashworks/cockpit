*.bak
*.bak*
*~
Thumbs.db
.DS_Store

# a project's own Cockpit folder, if the engine folder is ever opened as a project
.cockpit/

# Setup.cmd's private Node copy
runtime/

# the Home project the engine makes on first start (index.js) - your own desk, never committed
/home/
