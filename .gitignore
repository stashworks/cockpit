projects.json
fleet.json
turns.jsonl
engine.json
logs/
run/
backups/
*.log
*.db
*.db-shm
*.db-wal
*.sqlite

# secrets and local settings
.env
.env.*
!.env.example
# coders' own Claude logins (engine/fleet.js addAgent) - account tokens, never committed
accounts/

