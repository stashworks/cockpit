# {{TITLE}} environment. Copy to .env in each checkout; .env is never committed.
# dev: {{NAME}}_dev (:{{PORT_DEV}}, database {{NAME}}_dev)   prod: {{NAME}}_prod (:{{PORT_PROD}}, database {{NAME}})
{{UPPER}}_ENV=dev
PORT={{PORT_DEV}}

# MySQL 8 on this machine. One database per environment; a dedicated user with rights to it only.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME={{NAME}}_dev
DB_USER={{NAME}}
DB_PASSWORD=

# AI (later modules): local first. Never a cloud API key in a dev .env unless the owner says so.
OLLAMA_URL=http://127.0.0.1:11434
